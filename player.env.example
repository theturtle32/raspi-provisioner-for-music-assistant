# Player provisioning config — copy to player.env and fill in values

# IP address of the Music Assistant server
MA_HOST=192.168.3.42

# Player type: snapcast or airplay
PLAYER_TYPE=snapcast

# Room name (used for hostname and Music Assistant player name).
# Under CHANNEL_SPLIT it only labels the box and gives it its hostname; the
# player names come from LEFT_ROOM and RIGHT_ROOM instead.
ROOM_NAME="kitchen"

# ALSA audio device (use 'auto' to detect the first non-built-in card)
AUDIO_DEVICE=auto

# Snapcast latency offset in milliseconds (default: 0).
# Compensates for hardware latency differences between players.
# Negative values play earlier (for faster hardware like I2S HATs).
# Tune empirically via: curl http://<MA_HOST>:1780/jsonrpc -d '{"id":1,"jsonrpc":"2.0","method":"Client.SetLatency","params":{"id":"<mac>","latency":-20}}'
# SNAPCLIENT_LATENCY=-20

# WiFi mode: builtin (default), usb, or none (ethernet only)
# Prefer 'builtin' — read the WiFi modes section of the README before choosing
# 'usb'. Note that patch-userdata.py pre-fills this prompt from the value
# already on the card, so pressing Enter keeps whatever mode was set before.
WIFI_MODE=builtin

# Snapcast client id (optional; snapcast only). Snapcast derives the id from a
# MAC address, so a player that changes which interface it uses — switching
# WIFI_MODE, or moving to ethernet — arrives in Music Assistant as a brand-new
# player and loses its name, volume and group membership. Pin the id to the MAC
# it already has and it stays the player it was. Leave unset for new builds.
# SNAPCAST_HOST_ID=b8:27:eb:d3:3e:b4

# Written automatically by patch-userdata.py from the git revision of the
# provisioner that prepared the card. Do not set this by hand.
# PROVISIONER_VERSION=

# ── Clock ─────────────────────────────────────────────────────────────────────
# The Pi has no RTC, so its clock is wrong from boot until NTP lands. Debian's
# default pool is across the WAN and can take minutes; the clock then steps
# forward mid-session, which breaks Snapcast's time sync and stops playback
# while the player still looks connected.
#
# NTP_SERVER: 'gateway' (default) auto-detects your router, which almost always
# answers in milliseconds. Or give an IP/hostname, or 'default' to leave
# Debian's pool alone. The pool is always kept as a fallback.
NTP_SERVER=gateway

# Seconds the player waits for a synchronised clock before starting. Bounded and
# always succeeds, so a dead NTP server delays the player rather than silencing
# it. 0 disables the wait entirely. Affects only the player, nothing else boots
# any slower.
TIMESYNC_WAIT=45

# Audio HAT overlay (optional): merus-amp, hifiberry-amp, hifiberry-dac, hifiberry-dacplus, none
# HAT_OVERLAY=merus-amp

# ── Channel-split mode (one stereo card, two independent mono players) ────────
# For two rooms that each have a single speaker, wired one per amplifier channel.
# Each zone becomes its own player in Music Assistant and hears the whole mix,
# both channels summed to mono, rather than half the stereo image.
#
# Snapcast only, and mutually exclusive with MULTI_OUTPUT. LEFT_ROOM is the first
# channel of the card. On first boot the startup chime plays on each configured
# zone in channel order, which is how you find out which speaker is on which.
#
# Set only one of the two if only one speaker is wired so far: the other channel's
# ALSA device is still defined, and naming it later adds a player without
# disturbing the one already in service.
# CHANNEL_SPLIT=true
# LEFT_ROOM="guest bathroom"
# RIGHT_ROOM="primary bathroom"
# LEFT_LATENCY=0
# RIGHT_LATENCY=0
#
# Gain applied to each half of the mono downmix. 0.5 (the default) cannot clip;
# 1.0 is 6 dB louder and will clip anything centre-panned, which is most vocals.
# MONO_MIX_GAIN=0.5

# ── Multi-output mode (USB hub with multiple DACs) ────────────────────────────
# MULTI_OUTPUT=true
# USB_VENDOR_ID=0d8c
# USB_PRODUCT_ID=0008
# OUTPUT_1_ROOM="kitchen"
# OUTPUT_1_USB_PORT=1-1.2
# OUTPUT_1_LATENCY=-20
# OUTPUT_2_ROOM="garage"
# OUTPUT_2_USB_PORT=1-1.3
# OUTPUT_2_LATENCY=0
