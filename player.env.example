# Player provisioning config — copy to player.env and fill in values

# IP address of the Music Assistant server
MA_HOST=192.168.3.42

# Player type: snapcast or airplay
PLAYER_TYPE=snapcast

# Room name (used for hostname and Music Assistant player name)
ROOM_NAME="kitchen"

# ALSA audio device (use 'auto' to detect the first non-built-in card)
AUDIO_DEVICE=auto

# Snapcast latency offset in milliseconds (default: 0).
# Compensates for hardware latency differences between players.
# Negative values play earlier (for faster hardware like I2S HATs).
# Tune empirically via: curl http://<MA_HOST>:1780/jsonrpc -d '{"id":1,"jsonrpc":"2.0","method":"Client.SetLatency","params":{"id":"<mac>","latency":-20}}'
# SNAPCLIENT_LATENCY=-20

# WiFi mode: builtin (default), usb, or none (ethernet only)
# Prefer 'builtin' — read the WiFi modes section of the README before choosing
# 'usb'. Note that patch-userdata.py pre-fills this prompt from the value
# already on the card, so pressing Enter keeps whatever mode was set before.
WIFI_MODE=builtin

# Written automatically by patch-userdata.py from the git revision of the
# provisioner that prepared the card. Do not set this by hand.
# PROVISIONER_VERSION=

# Audio HAT overlay (optional): merus-amp, hifiberry-amp, hifiberry-dac, hifiberry-dacplus, none
# HAT_OVERLAY=merus-amp

# ── Multi-output mode (USB hub with multiple DACs) ────────────────────────────
# MULTI_OUTPUT=true
# USB_VENDOR_ID=0d8c
# USB_PRODUCT_ID=0008
# OUTPUT_1_ROOM="kitchen"
# OUTPUT_1_USB_PORT=1-1.2
# OUTPUT_1_LATENCY=-20
# OUTPUT_2_ROOM="garage"
# OUTPUT_2_USB_PORT=1-1.3
# OUTPUT_2_LATENCY=0
